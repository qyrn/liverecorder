{
  "name": "liverecorder",
  "version": "1.0.0",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  },
  "scripts": {
    "dev": "concurrently \"cross-env PORT=3001 pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "dev:landing": "pnpm --filter landing dev",
    "start": "pnpm --filter backend start",
    "build": "pnpm --filter frontend build",
    "build:landing": "pnpm --filter landing build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3"
  }
}
